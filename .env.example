# Jira Configuration
JIRA_URL=https://your-jira.instance.com
JIRA_USERNAME=your-username
JIRA_API_TOKEN=your-api-token

JIRA_PROJECT_KEY=PROJECTKEY

# Teams configuration: COMPONENT_NAME|"Jira Board Display Name", comma-separated.
# The component name filters issues by Jira component; the board name is used for
# sprint lookups. If no pipe separator is given, the component name is used for both.
TEAMS=PROCESSING|"PROCESSING Team",STABLETEK|"STABLETEK Team"

# Custom field IDs (update to match your Jira instance)
# Epic field (default example): customfield_14500
JIRA_EPIC_FIELD=customfield_14500
# Story points field (default example): customfield_10004
JIRA_SP_FIELD=customfield_10004
# Components field name of Jira Issue. 
#JIRA_COMPONENT_FIELD="components"

# Issue types included in sprint reports and delivery metrics (comma-separated)
ISSUE_TYPES=Bug,Story,Task

# Labels tracked by the AI-usage label report and the labels dashboard (comma-separated)
REPORT_LABELS=ai-assisted,ai-assisted-ba,ai-assisted-dev,ai-assisted-qa

# Document Configuration
DEFAULT_OUTPUT_FILE=sprint-issues.docx

# Delivery dashboard (/delivery) and get-delivery-report
# Number of closed sprints shown by default (the page also offers 3, 6, 9, 12; max 24)
DELIVERY_SPRINT_COUNT=6
# Length of the "open bugs by day" series, in days
DELIVERY_BUG_DAYS=30
# Where closed-sprint results are kept between runs (gitignored). Delete to rebuild from Jira
DELIVERY_CACHE_DIR=.cache/delivery
# How long a built report is reused in memory (Go duration); the Refresh button bypasses it
DELIVERY_CACHE_TTL=15m
# Resolutions that count as delivered for lead/cycle time and fixed bugs (comma-separated).
# Leave empty to count every resolution, which is what Delivery Central does
DELIVERY_COMPLETED_RESOLUTIONS=
